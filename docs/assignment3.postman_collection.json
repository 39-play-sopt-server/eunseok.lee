{
  "info": {
    "name": "SOPT 3차 필수 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "postId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 회원 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/members",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman 확인 회원\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"memberId\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "02 게시글 생성",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/posts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman 확인 글\",\n  \"content\": \"작성자와 생성일 확인\",\n  \"category\": \"FREE\",\n  \"memberId\": {{memberId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", function () { pm.response.to.have.status(201); });",
              "pm.collectionVariables.set(\"postId\", pm.response.json().data.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 페이지네이션 최신순",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/posts?page=1&size=2"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 상세 조회수 증가",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 게시글 수정",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/posts/{{postId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"수정한 제목\",\n  \"content\": \"수정한 내용\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 회원 삭제 (작성한 글 함께 삭제)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/v1/members/{{memberId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 OK\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 삭제된 게시글 조회",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/posts/{{postId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 Not Found\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    }
  ]
}